{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@repwise/engine": ["./packages/engine/src/index.ts"],
      "@repwise/content": ["./packages/content/src/index.ts"],
      "@repwise/content/toEngine": ["./packages/content/src/toEngine.ts"],
      "@repwise/content/media": ["./packages/content/src/media.ts"],
      "@repwise/content/enums": ["./packages/content/src/enums.ts"],
      "@repwise/content/*": ["./packages/content/*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "packages", "server"]
}
